{
	"template": {
		"revision": "pixel-plot-001",
		"annotations": {
			"run.googleapis.com/cpu-throttling": "true"
		},
		"executionEnvironment": "EXECUTION_ENVIRONMENT_GEN1",
		"scaling": {
			"minInstanceCount": 0,
			"maxInstanceCount": 1
		},
		"serviceAccount": "334525373884-compute@developer.gserviceaccount.com",
		"timeout": "300s",
		"containers": [
			{
				"name": "app",
				"image": "us-central1-docker.pkg.dev/pixel-plot-2026/pixel-plot/app:latest",
				"command": ["/bin/sh"],
				"args": [
					"-c",
					"until [ -f /data/.restored ]; do sleep 0.3; done\nexec node build"
				],
				"env": [
					{
						"name": "PIXEL_DB",
						"value": "/data/pixel.db"
					}
				],
				"ports": [
					{
						"containerPort": 8080
					}
				],
				"resources": {
					"limits": {
						"cpu": "1",
						"memory": "512Mi"
					}
				},
				"volumeMounts": [
					{
						"name": "data",
						"mountPath": "/data"
					}
				]
			},
			{
				"name": "litestream",
				"image": "litestream/litestream:0.5",
				"command": ["/bin/sh"],
				"args": [
					"-c",
					"cat > /tmp/litestream.yml <<'EOF'\ndbs:\n  - path: /data/pixel.db\n    replicas:\n      - url: gs://pixel-plot-2026-litestream/pixel.db\nEOF\nlitestream restore -if-replica-exists -config /tmp/litestream.yml /data/pixel.db\ntouch /data/.restored\nexec litestream replicate -config /tmp/litestream.yml"
				],
				"resources": {
					"limits": {
						"cpu": "0.5",
						"memory": "128Mi"
					}
				},
				"volumeMounts": [
					{
						"name": "data",
						"mountPath": "/data"
					}
				]
			}
		],
		"volumes": [
			{
				"name": "data",
				"emptyDir": {}
			}
		]
	},
	"traffic": [
		{
			"type": "TRAFFIC_TARGET_ALLOCATION_TYPE_LATEST",
			"percent": 100
		}
	]
}
